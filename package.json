{
  "name": "datasheet-to-tscircuit",
  "version": "0.1.0",
  "private": true,
  "trustedDependencies": [
    "altiumts"
  ],
  "type": "module",
  "description": "Turn component datasheets into validated tscircuit components and SPICE models",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"bun --watch src/server/index.ts\" \"vite\"",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:web": "vite",
    "debug": "bun src/cli/pipeline-debug.ts",
    "auth:openai": "docker compose run --rm --no-deps -e PI_OAUTH_CALLBACK_HOST=0.0.0.0 -p 127.0.0.1:1455:1455 app ./node_modules/.bin/tsci-agent auth login --openai",
    "build": "sh scripts/docker-compose-with-source.sh build",
    "build:web": "vite build",
    "start": "sh scripts/docker-compose-with-source.sh up --build",
    "start:server": "bun src/server/index.ts",
    "stop": "docker compose down",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:docker": "sh scripts/docker-smoke-test.sh",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run format:check && bun run typecheck && bun test && bun run build:web"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@resvg/resvg-js": "^2.6.2",
    "@tscircuit/ngspice-spice-engine": "^0.0.19",
    "circuit-json-to-altium": "github:tscircuit/circuit-json-to-altium#b7027586888496a21c8531fffd2f871068d5f64d",
    "circuit-json-to-kicad": "0.0.173",
    "jszip": "^3.10.1",
    "polygon-clipping": "0.15.7",
    "tsci-agent": "0.1.11",
    "tscircuit": "0.0.2110",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tscircuit/3d-viewer": "^0.0.577",
    "@tscircuit/assembly-viewer": "^0.0.6",
    "@tscircuit/core": "^0.0.1467",
    "@tscircuit/create-snippet-url": "^0.0.15",
    "@tscircuit/eval": "0.0.1023",
    "@tscircuit/internal-dynamic-import": "^0.0.11",
    "@tscircuit/pcb-viewer": "1.11.375",
    "@tscircuit/props": "0.0.585",
    "@tscircuit/runframe": "0.0.2227",
    "@tscircuit/schematic-viewer": "^2.0.74",
    "@types/bun": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "class-variance-authority": "^0.7.1",
    "circuit-json": "0.0.450",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "latest",
    "debug": "^4.4.0",
    "fflate": "^0.8.2",
    "fuse.js": "^7.1.0",
    "ky": "^1.7.5",
    "lucide-react": "latest",
    "marked": "^15.0.12",
    "posthog-js": "^1.253.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-error-boundary": "^6.0.0",
    "react-hot-toast": "^2.5.2",
    "react-query": "^3.39.3",
    "tailwind-merge": "^2.6.0",
    "vite": "latest",
    "zustand": "^4.5.7"
  },
  "engines": {
    "bun": ">=1.2.21"
  },
  "packageManager": "bun@1.3.9"
}
